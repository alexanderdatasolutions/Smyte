      "t2_equipment": "Uses T2 processed + beast_scales + forging_flame",
      "t3_equipment": "Uses T3 processed + elemental_cores + divine_flame",
      "t4_equipment": "Uses T4 processed + dragon_parts + eternal_flame (PvP only)"
    }
  },

