{
  "_metadata": {
    "version": "5.1.0",
    "description": "Equipment crafting recipes with mythological set bonuses",
    "last_updated": "2026-02-15",
    "design_notes": {
      "structure": "Flat structure - equipment recipes at top level",
      "set_bonuses": "2-piece and 4-piece bonuses for complete sets",
      "t1_equipment": "Uses T1 processed + monster_parts + basic_flame",
      "t2_equipment": "Uses T2 processed + beast_scales + forging_flame",
      "t3_equipment": "Uses T3 processed + elemental_cores + divine_flame",
      "t4_equipment": "Uses T4 processed + dragon_parts + eternal_flame (PvP only)",
      "naming_theme": "Smyte mythological flavor - gods, titans, divine powers"
    },
    "set_bonus_reference": {
      "wrath": {"2pc": "+15% ATK", "4pc": "+30% ATK"},
      "aegis": {"2pc": "+15% DEF", "4pc": "+30% DEF, +15% HP"},
      "zephyr": {"2pc": "+25 SPD", "4pc": "+50 SPD"},
      "titan": {"2pc": "+15% HP", "4pc": "+30% HP"},
      "precision": {"2pc": "+12% Crit Rate", "4pc": "+25% Crit Rate"},
      "fury": {"2pc": "+20% Crit Damage", "4pc": "+40% Crit Damage"},
      "oracle": {"2pc": "+20% Accuracy", "4pc": "+40% Accuracy"},
      "fortitude": {"2pc": "+20% Resistance", "4pc": "+40% Resistance"},
      "siphon": {"2pc": "+10% Lifesteal", "4pc": "+25% Lifesteal"},
      "thunderstrike": {"2pc": "+15% Stun Chance", "4pc": "+25% Stun Chance"},
      "relentless": {"2pc": "+10% Extra Turn", "4pc": "+22% Extra Turn"},
      "nemesis": {"2pc": "+15% Counter", "4pc": "+30% Counter"},
      "resolve": {"2pc": "+1 turn immunity", "4pc": "+2 turn immunity at battle start"},
      "conquest": {"2pc": "+20% ATK in PvP", "4pc": "+40% ATK in PvP, ignore 15% DEF"},
      "eternal": {"2pc": "+20% DEF in PvP", "4pc": "+40% DEF in PvP, +25% HP"}
    }
  },

