  "_metadata": {
    "version": "1.0.0",
    "description": "Building definitions for hex tile construction. Players capture blank tiles, then choose what to build.",
    "last_updated": "2026-02-11",
    "design_notes": {
      "normalization": "Flat structure with foreign keys to resources.json",
      "categories": "extraction, processing, crafting, divine, infrastructure",
      "tier_rule": "Building tier must be <= tile tier (T2 building needs T2+ tile)",
      "production": "Values are per-hour rates, scaled by workers and upgrades",
      "one_building_per_tile": "Each tile supports exactly one building"
    }
  },

