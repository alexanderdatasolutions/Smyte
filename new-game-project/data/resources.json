{
  "_metadata": {
    "version": "4.0.0",
    "description": "Tiered pyramid economy - each tier needs lower tier resources for conversion",
    "last_updated": "2026-02-10",
    "design_notes": {
      "pyramid_economy": "Higher tier processing requires EXTRA lower tier raw materials",
      "T1": "Base tier - ore/wood/herbs gathered, processed into T1 processed",
      "T2": "Requires T2 raw + extra T1 raw to make T2 processed",
      "T3": "Requires T3 raw + extra T2 raw to make T3 processed",
      "T4": "PvP only - requires T4 raw + extra T3 raw",
      "defense_drops": "Monster parts tiered by node tier defended",
      "flames": "Tiered forging flames required for each equipment tier"
    }
  },

