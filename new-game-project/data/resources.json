    "by_material_type": {
      "raw": ["ore", "wood", "herbs", "fine_ore", "hardwood", "exotic_herbs", "arcane_ore", "ancient_wood", "mystic_herbs", "magic_crystals", "celestial_ore"],
      "processed": ["refined_metal", "quality_timber", "rare_herbs", "steel_ingot", "treated_lumber", "alchemical_extract", "prometheum", "enchanted_wood", "mystic_bloom", "astral_shard", "divine_metal"],
      "defense_drop": ["monster_parts", "beast_scales", "elemental_cores", "dragon_parts"],
      "flame": ["basic_flame", "forging_flame", "divine_flame", "eternal_flame"]
    },
    "conversion_chains": {
      "metal": {
        "t1": {"input": ["ore"], "output": "refined_metal"},
        "t2": {"input": ["fine_ore", "ore"], "output": "steel_ingot"},
        "t3": {"input": ["arcane_ore", "fine_ore"], "output": "prometheum"},
        "t4": {"input": ["celestial_ore", "arcane_ore"], "output": "divine_metal"}
      },
      "wood": {
        "t1": {"input": ["wood"], "output": "quality_timber"},
        "t2": {"input": ["hardwood", "wood"], "output": "treated_lumber"},
        "t3": {"input": ["ancient_wood", "hardwood"], "output": "enchanted_wood"}
      },
      "herbs": {
        "t1": {"input": ["herbs"], "output": "rare_herbs"},
        "t2": {"input": ["exotic_herbs", "herbs"], "output": "alchemical_extract"},
        "t3": {"input": ["mystic_herbs", "exotic_herbs"], "output": "mystic_bloom"}
      },
      "crystals": {
        "t3": {"input": ["magic_crystals"], "output": "astral_shard"}
      }
    },
    "equipment_crafting": {
      "t1_common": {
        "materials": ["refined_metal", "quality_timber", "rare_herbs"],
        "defense": "monster_parts",
        "flame": "basic_flame"
      },
      "t2_rare": {
